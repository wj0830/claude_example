{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*secret*)",
      "Read(**/*credential*)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(.ssh/**)",
      "Read(.aws/**)",
      "Edit(./.env)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.production)",
      "Edit(**/.env.development)",
      "Edit(**/.env.test)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.pfx)",
      "Edit(**/*.p12)",
      "Edit(**/*secret*)",
      "Edit(**/*credential*)",
      "Edit(**/id_rsa*)",
      "Edit(**/id_ed25519*)",
      "Edit(.ssh/**)",
      "Edit(.aws/**)",
      "Write(./.env)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.*.local)",
      "Write(**/.env.production)",
      "Write(**/.env.development)",
      "Write(**/.env.test)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/*.pfx)",
      "Write(**/*.p12)",
      "Write(**/*secret*)",
      "Write(**/*credential*)",
      "Write(**/id_rsa*)",
      "Write(**/id_ed25519*)",
      "Write(.ssh/**)",
      "Write(.aws/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/tdd-reminder.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  }
}
